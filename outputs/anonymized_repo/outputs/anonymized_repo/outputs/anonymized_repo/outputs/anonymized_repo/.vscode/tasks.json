{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile LaTeX (Working latexmk)",
            "type": "shell",
            "command": "${workspaceFolder}/docs/texcompile.bat",
            "args": ["-pdf", "${fileBasename}"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "label": "Compile LaTeX (Custom Script)",
            "type": "shell",
            "command": "${workspaceFolder}/docs/compile_latex.bat",
            "args": ["${fileBasename}"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "label": "Clean LaTeX Files",
            "type": "shell",
            "command": "del",
            "args": ["*.aux", "*.log", "*.fdb_latexmk", "*.fls", "*.synctex.gz"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "cwd": "${fileDirname}"
            }
        }
    ]
}