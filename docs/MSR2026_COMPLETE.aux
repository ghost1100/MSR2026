\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Comprehensive Analysis of AI Agent Testing Behavior (Complete Dataset)}}{5}{}\protected@file@percent }
\newlabel{tab:main_results}{{I}{5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Test contribution rates by AI agent. Bar chart shows percentage of pull requests containing test-related content for each agent. OpenAI Codex: 98.5\%, GitHub Copilot: 79.6\%, Claude Code: 76.7\%, Devin: 66.6\%, Cursor: 18.7\%. Data from 932,791 pull requests.}}{5}{}\protected@file@percent }
\newlabel{fig:test_contribution_rates}{{1}{5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Agent market share distribution with legend showing counts and percentages.}}{5}{}\protected@file@percent }
\newlabel{fig:agent_distribution}{{2}{5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Multi-panel analysis of agent behaviors. Four panels show: (1) test contribution rates (\%), (2) number of unique users, (3) PR acceptance rates (\%), and (4) average PR title length (characters). Despite large testing differences, acceptance rates vary from 78.6\% to 94.4\%.}}{6}{}\protected@file@percent }
\newlabel{fig:comprehensive_analysis}{{3}{6}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-B}}RQ2: Quality Metrics and Acceptance Patterns}{6}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-C}}RQ3: Observed Testing Patterns and Potential Interpretations}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Statistical validation of behavioral differences. Shows Chi-square test results (\(\chi ^2 = 389,069\), \(p < 0.001\)), effect size (Cramer's V = 0.646), and 95\% confidence intervals for each agent's test contribution rate. Large effect size confirms practical significance.}}{6}{}\protected@file@percent }
\newlabel{fig:statistical_analysis}{{4}{6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Behavioral signatures summary. Categorizes agents by testing approach: Testing-Centric (Codex: 98.5\%), Balanced (Copilot: 79.6\%, Claude: 76.7\%), Limited Data (Devin: 66.6\%, 1 user), and Rapid Development (Cursor: 18.7\%). Patterns may reflect fundamental design philosophies, though user base variations require careful interpretation.}}{7}{}\protected@file@percent }
\newlabel{fig:behavior_signatures}{{5}{7}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-D}}RQ4: Acceptance Rate Patterns}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Executive summary dashboard. Six-panel visualization integrating: (1) agent distribution pie chart, (2) test contribution bar chart, (3) user adoption counts, (4) acceptance rate comparison, (5) statistical validation metrics (\(\chi ^2\), Cram\u 00e9r's V), and (6) temporal stability analysis. Demonstrates observed patterns across 932,791 PRs from 72,189 developers.}}{7}{}\protected@file@percent }
\newlabel{fig:complete_analysis}{{6}{7}{}{}{}}
